{
  "kind": "tbmp-receptor-materialization-catalogue",
  "profile_version": "1.0",
  "tag_comparison": "ASCII case-insensitive; canonical output tags are lowercase; scientific identifier values remain case-sensitive",
  "category_order": "alphabetical ASCII by canonical category; source row order retained within each category",
  "unknown_category_action": "reject",
  "allowed_omission_prefixes": {
    "_pdbx_validate_": "omit all tags with category audit; never transfer deposition validation to derived artifact"
  },
  "required_categories": [
    "_atom_site",
    "_struct_asym",
    "_entity",
    "_chem_comp"
  ],
  "conditional_categories": {
    "retained_polymer_entity": [
      "_entity_poly",
      "_entity_poly_seq",
      "_pdbx_poly_seq_scheme"
    ],
    "retained_branched_entity": [
      "_pdbx_entity_branch",
      "_pdbx_entity_branch_list",
      "_pdbx_branch_scheme"
    ],
    "retained_struct_conn": [
      "_struct_conn_type"
    ]
  },
  "global_rules": [
    "No invented absent optional categories except generated _entry",
    "Required tags must exist; key and relationship columns must be non-null where the corresponding relation is required",
    "Unknown tags in filtered categories reject rather than silently disappear; explicitly omitted categories may contain arbitrary tags",
    "Third-partner columns in _struct_conn must contain only true CIF null markers; non-null values reject",
    "Preserve source tokens for retained fields; audit every dropped category/tag/row; generated entry ids are explicitly identified",
    "Catalogue keys are profile identity keys, not a claim that they reproduce every DDL primary key",
    "For retained polymer atoms, (label_entity_id,label_seq_id,label_comp_id) must match a declared entity_poly_seq(entity_id,num,mon_id); branch occurrence references use the full entity/num/comp key, never num alone",
    "No atom guessing to reconcile a missing-context annotation; refusal when its supported filtering rule cannot determine context"
  ],
